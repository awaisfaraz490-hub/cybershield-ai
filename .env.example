# Copy this file to .env and adjust values as needed.
# The application will run with safe defaults even if this file is missing.

ENV=development
DEBUG=true

# Auto-generated if left blank — set an explicit value in production so
# sessions survive restarts.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite by default — no setup required.
DATABASE_URL=sqlite:///./cybershield.db

MAX_UPLOAD_SIZE_MB=5
PERSIST_UPLOADED_IMAGES=false

# Optional — the app works fully with local heuristic analysis if left blank.
OPENAI_API_KEY=

# Optional future-ready threat-intel integrations (not required).
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

REQUEST_TIMEOUT_SECONDS=5
